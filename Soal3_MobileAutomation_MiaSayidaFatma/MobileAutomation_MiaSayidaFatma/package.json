{
  "name": "mobileautomation-miasayidafatma",
  "version": "1.0.0",
  "private": true,
  "description": "Eraspace mobile login automation using WebdriverIO + Appium + Cucumber BDD",
  "type": "commonjs",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:login": "wdio run ./wdio.conf.js --spec ./features/eraspace/login.feature",
    "test:login:negative": "wdio run ./wdio.conf.js --spec ./features/eraspace/login.feature --cucumberOpts.tagExpression=\"@TC_1_1\"",
    "test:login:positive": "wdio run ./wdio.conf.js --spec ./features/eraspace/login.feature --cucumberOpts.tagExpression=\"@TC_1_2\"",
    "appium": "appium --address 127.0.0.1 --port 4723",
    "doctor": "node ./scripts/check-setup.js"
  },
  "devDependencies": {
    "@wdio/cli": "^9.19.0",
    "@wdio/local-runner": "^9.19.0",
    "@wdio/cucumber-framework": "^9.19.0",
    "@wdio/spec-reporter": "^9.19.0",
    "@wdio/appium-service": "^9.19.0",
    "appium": "^2.15.0",
    "dotenv": "^16.4.5"
  }
}
